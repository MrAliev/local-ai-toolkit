<Window x:Class="LocalAi.Installer.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalAi.Installer.ViewModels"
        xmlns:local="clr-namespace:LocalAi.Installer"
        Background="{DynamicResource WindowFill}"
        Foreground="{DynamicResource TextPrimary}"
        Icon="pack://application:,,,/Resources/localai.ico"
        Title="{vm:Label RemoveLocalAi}"
        Width="760"
        Height="560"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <Window.Resources>
        <local:CompactRailWidthConverter x:Key="RailWidth" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <DataTemplate x:Key="StepTemplate">
            <TextBlock Text="{Binding Title}" Margin="0,0,0,6" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="ShellLayout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ActualWidth, ElementName=ShellLayout, Converter={StaticResource RailWidth}, ConverterParameter=200}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource RailFill}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,20,12,16">
                <TextBlock Text="{vm:Label RemoveLocalAi}" FontSize="15" FontWeight="Bold" Margin="0,0,0,16" />
                <ItemsControl ItemsSource="{Binding StepList}"
                              ItemTemplate="{StaticResource StepTemplate}" />
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- The same arrangement as the installation wizard: the panel heads the content column,
             level with the rail's title, and is reached from Apps & features too. -->
        <Grid Grid.Column="1" Margin="20,20,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:PreferencesBar Grid.Row="0" Margin="0,0,0,12"
                                  DataContext="{Binding Presentation}" />

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <local:LiveStatusText Text="{Binding StepTitle}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StepDescription}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding StepStatus}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                <Border Background="{DynamicResource ErrFill}" BorderBrush="{DynamicResource ErrLine}" BorderThickness="1" CornerRadius="3"
                        Padding="8,6" Margin="0,8,0,0"
                        Visibility="{Binding HasUnexpectedError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding UnexpectedError}" Foreground="{DynamicResource ErrText}" />
                </Border>
                <!-- Another wizard is running, or there is nothing here to remove. Either way
                     this run does not start. -->
                <Border Background="{DynamicResource WarnFill}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="3"
                        Padding="8,6" Margin="0,8,0,0"
                        Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding BlockingNotice}" Foreground="{DynamicResource WarnText}" />
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- What to remove -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:UninstallPage.Choose}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock x:Name="StartFromLabel" Text="{vm:Label StartFrom}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <GroupBox Style="{StaticResource NamedGroup}"
                                  AutomationProperties.LabeledBy="{x:Reference StartFromLabel}">
                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="Preset" Margin="0,0,0,8"
                                                     AutomationProperties.Name="{Binding Title}"
                                                     AutomationProperties.HelpText="{Binding Description}"
                                                     Tag="{Binding Preset}"
                                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                     Checked="OnPresetChecked">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>

                        <TextBlock Text="{vm:Label WhatGoes}" FontWeight="SemiBold" Margin="0,10,0,6" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,0,10"
                                              AutomationProperties.Name="{Binding AccessibleName}"
                                              AutomationProperties.HelpText="{Binding Note}">
                                        <StackPanel>
                                            <!-- A Grid, not a horizontal StackPanel: that panel
                                                 measures its children with infinite width, so
                                                 neither of these could wrap however they asked. -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding DecisionText}"
                                                           Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                           FontStyle="Italic" Margin="8,0,0,0" />
                                            </Grid>
                                            <TextBlock Text="{Binding Note}"
                                                       Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{vm:Label ConnectedRepositories}" FontWeight="SemiBold" Margin="0,10,0,6" />
                        <!-- The scan asks Git in every connected repository; until it has, the list
                             below is not whole and Next waits. -->
                        <Grid Margin="0,2,0,8"
                              Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Control Style="{StaticResource BusyGears}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                            <local:LiveStatusText Grid.Column="1" Text="{vm:Label LookingForRepositories}"
                                                  Style="{StaticResource Muted}" TextWrapping="Wrap" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Repositories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanChoose}"
                                              AutomationProperties.Name="{Binding AccessibleName}"
                                              AutomationProperties.HelpText="{Binding StateText}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CommonDirectory}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource Muted}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The loudest thing on the page, and the only choice a preset never
                             makes for you. -->
                        <Border Background="{DynamicResource WarnFill}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1"
                                CornerRadius="3" Padding="8,6" Margin="0,10,0,0">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding RemoveSigningKeys}"
                                          AutomationProperties.Name="{Binding SigningKeysTitle}"
                                          AutomationProperties.HelpText="{Binding SigningKeysWarning}">
                                    <TextBlock Text="{Binding SigningKeysTitle}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Text="{Binding SigningKeysWarning}" Foreground="{DynamicResource WarnText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Confirm -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:UninstallPage.Confirm}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- Above the list, not after it: the box scrolls and is 300 high, so
                             anything below it sits between the list and the consent tick and
                             competes with it. A sentence that frames a list goes before it. -->
                        <TextBlock Text="{Binding KeepNotice}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding HasKeepNotice, Converter={StaticResource BoolToVisibility}}" />
                        <local:EffectsOverview DataContext="{Binding ReviewGroups}" />
                        <Expander Header="{vm:Label TechnicalDetails}">
                            <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap" Height="220"
                                     FontFamily="Consolas"
                                     VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}" />
                        </Expander>
                        <CheckBox Margin="0,12,0,0"
                                  IsChecked="{Binding IsConfirmed}"
                                  AutomationProperties.Name="{vm:Label RemovalConsent}">
                            <TextBlock Text="{vm:Label RemovalConsent}" TextWrapping="Wrap" />
                        </CheckBox>
                    </StackPanel>

                    <!-- Progress -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:UninstallPage.Progress}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Control Style="{StaticResource BusyGears}"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>

                    <!-- Finish -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:UninstallPage.Finish}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <local:LiveStatusText Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBox Text="{Binding JournalLine, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent" Margin="0,0,0,12"
                                 Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}" />
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="{vm:Label CopyRemovalReport}" Click="OnCopyReport" Margin="0,0,8,4" Padding="12,4" />
                            <Button Content="{vm:Label SaveRemovalReport}" Click="OnSaveReport" Margin="0,0,8,4" Padding="12,4" />
                            <Button Content="{vm:Label OpenReportFolder}" Click="OnOpenReportFolder" Margin="0,0,0,4" Padding="12,4"
                                    Visibility="{Binding HasReportPath, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <TextBox Text="{Binding ReportPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent" Margin="0,0,0,12"
                                 Visibility="{Binding HasReportPath, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding ReportSaveError}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Visibility="{Binding HasReportSaveError, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander Header="{vm:Label Report}" Margin="0,0,0,12">
                            <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     Height="220" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}" />
                        </Expander>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="3" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                <StackPanel>
                <!-- Above the buttons, because Next is what started it. -->
                <Grid Margin="0,0,0,8"
                      Visibility="{Binding IsPlanning, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Control Style="{StaticResource BusyGears}"
                             Visibility="{Binding IsPlanning, Converter={StaticResource BoolToVisibility}}" />
                    <local:LiveStatusText Grid.Column="1" Text="{vm:Label ListingRemoval}"
                                          Style="{StaticResource Muted}" TextWrapping="Wrap" />
                </Grid>
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="{vm:Label Back}" Style="{StaticResource NavButton}"
                            Command="{Binding BackCommand}" />
                    <Button Content="{vm:Label Next}" Style="{StaticResource NavButton}"
                            IsDefault="{Binding IsNextVisible}"
                            Command="{Binding NextCommand}"
                            Visibility="{Binding IsNextVisible, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{vm:Label Uninstall}" Style="{StaticResource NavButton}" IsDefault="{Binding IsUninstallVisible}"
                            Command="{Binding UninstallCommand}"
                            Visibility="{Binding IsUninstallVisible, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Keep the next step visible while the removal report scrolls. It is
                         offered only after the removal half of a clean reinstall succeeds. -->
                    <Button Content="{vm:Label ContinueToInstall}" Style="{StaticResource NavButton}"
                            IsDefault="{Binding CanContinueToInstall}"
                            Command="{Binding ContinueToInstallCommand}"
                            Visibility="{Binding CanContinueToInstall, Converter={StaticResource BoolToVisibility}}" />
                    <!-- After a run that did not finish: back to the first page with the same
                         choices. Not the default: it starts the way to another deletion. -->
                    <Button Content="{vm:Label RemoveWhatIsLeft}" Style="{StaticResource NavButton}"
                            Command="{Binding RemoveWhatIsLeftCommand}"
                            Visibility="{Binding CanRemoveWhatIsLeft, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{Binding CancelButtonText}" Style="{StaticResource NavButton}" IsCancel="True"
                            Command="{Binding CancelCommand}" />
                </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
