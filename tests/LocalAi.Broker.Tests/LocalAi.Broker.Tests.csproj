<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <EmbeddedResource Include="..\Fixtures\TokenCalibration\*.json;..\Fixtures\TokenCalibration\*.png;..\Fixtures\TokenCalibration\*.pdf"
                      LogicalName="TokenCalibration.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LocalAi.Broker.Client\LocalAi.Broker.Client.csproj" />
    <ProjectReference Include="..\..\src\LocalAi.Broker\LocalAi.Broker.csproj" />
    <ProjectReference Include="..\..\src\LocalAi.Contracts\LocalAi.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The entry points pin the language and invariant formatting; a test calling a tool
         method directly never goes through one, so they are pinned here too. -->
    <Compile Include="..\Shared\TestCulture.cs" Link="TestCulture.cs" />
  </ItemGroup>
</Project>
