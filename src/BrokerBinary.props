<Project>

  <!-- Components that may start the broker need LocalAi.Broker.exe next to them, because
       BrokerProcess resolves it through AppContext.BaseDirectory.

       In an installed layout the version directory contains it. A build output is not an
       installed layout, so it has to be copied here. This used to happen by accident: the
       client referenced the broker's Exe project, which dragged its apphost into every
       dependent output and also caused NETSDK1152 on RID specific publishes. That reference
       is gone; the copy is declared here on purpose. A framework-dependent apphost needs
       its assembly, runtime configuration, dependency manifest and runtime dependencies,
       including satellite assemblies. Copy the broker's own build outputs, preserving
       relative paths. These are development output files, not ResolvedFileToPublish items;
       the release package continues to supply its separately published broker. -->

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)LocalAi.Broker\LocalAi.Broker.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <Target Name="CopyBrokerRuntimeForDevelopment" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)LocalAi.Broker\LocalAi.Broker.csproj"
             Targets="GetBrokerDevelopmentFiles"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="BrokerDevelopmentFiles" />
    </MSBuild>

    <Copy SourceFiles="@(BrokerDevelopmentFiles)"
          DestinationFiles="@(BrokerDevelopmentFiles->'$(OutDir)%(BrokerRelativePath)')"
          SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
  </Target>

</Project>
