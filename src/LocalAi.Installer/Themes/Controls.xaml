<!--
    The controls, restated against the palette.

    Every colour here is a DynamicResource, including the ones inside ControlTemplate and
    trigger setters: a StaticResource brush answers once, when the window loads, and then stops
    following the palette — one permanently light control among repainted ones.

    Most of this exists because the stock templates write colours of their own that belong to
    neither palette. Button, CheckBox and ComboBox hardcode a pale fill and a grey foreground in
    their disabled triggers; TextBox and ComboBox fall back to SystemColors.WindowBrush; the
    focus visual is a black dotted rectangle, invisible on a dark page; ScrollBar keeps its Aero
    template; and the ProgressBar's green gradient belongs to neither theme.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:local="clr-namespace:LocalAi.Installer"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One vocabulary of marks for the pages that show a list of things with states. Drawn as
         geometry rather than typed as a character: a font that lacks the glyph draws a box, and
         a stroke follows the palette's brushes the way text does not. -->
    <StreamGeometry x:Key="MarkTick">M 0 4 L 3 7 L 9 0</StreamGeometry>
    <StreamGeometry x:Key="MarkWarn">M 5 0 L 10 9 L 0 9 Z</StreamGeometry>
    <StreamGeometry x:Key="MarkFail">M 0 0 L 9 9 M 9 0 L 0 9</StreamGeometry>
    <StreamGeometry x:Key="MarkNone">M 0 4.5 L 9 4.5</StreamGeometry>
    <!-- Three quarters of a circle: a full one has no visible beginning, so it can turn without
         looking as though it is. -->
    <StreamGeometry x:Key="MarkBusy">M 5.5 0 A 5.5 5.5 0 1 1 0 5.5</StreamGeometry>
    <!-- The busy gears: nine teeth around (10,10) and six around (24.19,14.43), meshed at rest,
         so a pair that is not turning still sits in gear. Even-odd, so the axle holes stay open. -->
    <StreamGeometry x:Key="GearLarge">F0 M17.46,10.8 L19.8,11.97 A10,10 0 0 1 19.18,13.96 L16.59,13.58 A7.5,7.5 0 0 1 15.2,15.41 L16.25,17.81 A10,10 0 0 1 14.49,18.94 L12.74,16.98 A7.5,7.5 0 0 1 10.5,17.48 L9.76,20 A10,10 0 0 1 7.69,19.73 L7.61,17.11 A7.5,7.5 0 0 1 5.58,16.06 L3.39,17.51 A10,10 0 0 1 1.98,15.97 L3.6,13.91 A7.5,7.5 0 0 1 2.72,11.8 L0.11,11.5 A10,10 0 0 1 0.02,9.42 L2.58,8.88 A7.5,7.5 0 0 1 3.27,6.69 L1.46,4.8 A10,10 0 0 1 2.73,3.14 L5.04,4.38 A7.5,7.5 0 0 1 6.97,3.14 L6.8,0.53 A10,10 0 0 1 8.84,0.07 L9.81,2.5 A7.5,7.5 0 0 1 12.09,2.8 L13.64,0.69 A10,10 0 0 1 15.5,1.65 L14.67,4.13 A7.5,7.5 0 0 1 16.23,5.82 L18.78,5.21 A10,10 0 0 1 19.58,7.13 L17.35,8.51 A7.5,7.5 0 0 1 17.46,10.8 Z M12.8,10 A2.8,2.8 0 1 1 7.2,10 A2.8,2.8 0 1 1 12.8,10 Z</StreamGeometry>
    <StreamGeometry x:Key="GearSmall">F0 M20.26,12.11 L18.65,10.05 A7.07,7.07 0 0 1 20.27,8.55 L22.2,10.32 A4.57,4.57 0 0 1 24.23,9.87 L25.22,7.44 A7.07,7.07 0 0 1 27.33,8.1 L26.75,10.65 A4.57,4.57 0 0 1 28.17,12.19 L30.76,11.83 A7.07,7.07 0 0 1 31.24,13.98 L28.74,14.76 A4.57,4.57 0 0 1 28.12,16.75 L29.73,18.82 A7.07,7.07 0 0 1 28.11,20.32 L26.18,18.54 A4.57,4.57 0 0 1 24.15,19 L23.16,21.43 A7.07,7.07 0 0 1 21.05,20.77 L21.63,18.21 A4.57,4.57 0 0 1 20.21,16.68 L17.62,17.04 A7.07,7.07 0 0 1 17.14,14.88 L19.64,14.1 A4.57,4.57 0 0 1 20.26,12.11 Z M25.99,14.43 A1.8,1.8 0 1 1 22.39,14.43 A1.8,1.8 0 1 1 25.99,14.43 Z</StreamGeometry>

    <!-- A ring rather than the stock dotted rectangle, which is black and disappears on dark. -->
    <Style x:Key="FocusRingVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="1" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusRing}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- A group a screen reader can name, drawing nothing: UI Automation skips a panel, and a
         GroupBox is what it exposes as a group. -->
    <Style x:Key="NamedGroup" TargetType="GroupBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <!-- Generated labels must follow the button's active state,
                                     including disabled and system high-contrast colours. -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource Surface}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource SelectionFill}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentFill}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentFill}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </MultiTrigger>
                        <!-- The stock template writes its own pale fill and grey text here,
                             which is a light control on a dark page. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource WindowFill}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Divider}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- A Grid, not a horizontal StackPanel: that panel measures its children
                         with infinite width, so nothing inside a checkbox could ever wrap. The
                         cost is that the control now fills its container rather than hugging its
                         label, which makes the whole row the click target. -->
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Grid.Column="0" Width="15" Height="15" CornerRadius="2"
                                VerticalAlignment="Top" Margin="0,1,8,0"
                                SnapsToDevicePixels="True"
                                Background="{DynamicResource ControlFill}"
                                BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1">
                            <Path x:Name="Tick" Visibility="Collapsed"
                                  Stretch="Uniform" Margin="2"
                                  Data="M 0 4 L 3 7 L 9 0"
                                  StrokeThickness="1.6"
                                  Stroke="{DynamicResource WindowFill}" />
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Top"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource AccentFill}" />
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource AccentFill}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource WindowFill}" />
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Divider}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- Same shape as the checkbox above, and for the same reason: a rule on the
                         memory page carries a sentence saying what it costs, and that sentence
                         has to be allowed to wrap. -->
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="15" Height="15" VerticalAlignment="Top"
                              Margin="0,1,8,0" SnapsToDevicePixels="True">
                            <Ellipse x:Name="Ring"
                                     Fill="{DynamicResource ControlFill}"
                                     Stroke="{DynamicResource ControlBorder}"
                                     StrokeThickness="1" />
                            <Ellipse x:Name="Dot" Margin="4" Visibility="Collapsed"
                                     Fill="{DynamicResource AccentFill}" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Top"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke"
                                    Value="{DynamicResource AccentFill}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke"
                                    Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ring" Property="Fill"
                                    Value="{DynamicResource WindowFill}" />
                            <Setter TargetName="Ring" Property="Stroke"
                                    Value="{DynamicResource Divider}" />
                            <Setter TargetName="Dot" Property="Fill"
                                    Value="{DynamicResource TextDisabled}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Without these five the box falls back to SystemColors.WindowBrush, which is white. -->
    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectionFill}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,2" />
        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="False">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource WindowFill}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background"
                                    Value="{DynamicResource SelectionFill}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True" />
                        <ContentPresenter x:Name="Selected"
                                          Margin="8,0,28,0"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Path x:Name="Arrow" Width="9" Height="5"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,10,0" Stretch="Uniform"
                              Data="M 0 0 L 4 4 L 8 0"
                              StrokeThickness="1.4"
                              Stroke="{DynamicResource TextSecondary}" />
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Slide">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource ControlFill}"
                                    BorderBrush="{DynamicResource ControlBorder}"
                                    BorderThickness="1" CornerRadius="3" Margin="0,2,0,0">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource WindowFill}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Divider}" />
                            <Setter TargetName="Arrow" Property="Stroke"
                                    Value="{DynamicResource TextDisabled}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The Aero scrollbar keeps its own greys and a raised thumb, both of which read as a
         light control sitting on a dark page. -->
    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="4" Margin="3"
                            Background="{DynamicResource ScrollThumb}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background"
                                    Value="{DynamicResource ScrollThumbHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource ScrollTrack}" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}" />
                            </Track.Thumb>
                            <!-- No arrow buttons: they are the loudest part of the Aero
                                 template and the least used part of a scrollbar. -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="12" />
                            <Setter Property="Width" Value="Auto" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed"
                                    Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The stock expander arrives in Aero grey with a circle-and-chevron header that belongs to
         neither palette. A triangle that turns, and a header that is the whole row. -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="Header" Cursor="Hand" Focusable="True"
                                      FocusVisualStyle="{StaticResource FocusRingVisual}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="Arrow" Grid.Column="0"
                                              Width="8" Height="8" Margin="0,4,8,0"
                                              VerticalAlignment="Top" Stretch="Uniform"
                                              Data="M 0 0 L 5 4 L 0 8 Z"
                                              Fill="{DynamicResource TextSecondary}"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform />
                                            </Path.RenderTransform>
                                        </Path>
                                        <ContentPresenter Grid.Column="1" VerticalAlignment="Top" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Arrow" Property="Fill"
                                                    Value="{DynamicResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The stock bar is an Aero green gradient, which belongs to neither palette. -->
    <Style TargetType="ProgressBar">
        <Setter Property="local:MotionPreference.Enabled" Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Divider}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFill}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <Rectangle x:Name="PART_Track" />
                            <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                       RadiusX="3" RadiusY="3"
                                       Fill="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- A bar with nothing to measure still has to move, and the motion lives
                             here: WPF animates a glow rectangle its own template declares, and
                             this one replaces that template. A pulse rather than a sweep — a
                             travelling block needs the track's width, which this template has no
                             way to reach, and a fixed one reads as a gap on the 280-wide bar the
                             system check uses and as a crawl on a full-width one. -->
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="HorizontalAlignment"
                                    Value="Stretch" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsIndeterminate" Value="True" />
                                <Condition Property="local:MotionPreference.Enabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="Waiting">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1.0" To="0.30" Duration="0:0:0.9"
                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Waiting" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The busy spinner: two meshed gears, placed before the line that names the wait. Both in
         Accent, the owner's blue, which reads on a light page and a dark one and becomes the
         system highlight in high contrast. They show only once a wait has lasted 0.4 s, turn only
         while shown and while Windows allows animation, and stand still otherwise. No name and no
         focus: the line beside them is what a screen reader hears. The small gear has two thirds
         of the large one's teeth, so it turns in two thirds of the time to stay in mesh; each
         animation repeats on its own, or the shorter one would wait for the longer. -->
    <Style x:Key="BusyGears" TargetType="Control">
        <Setter Property="local:MotionPreference.Enabled" Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,-2,8,-4" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid x:Name="Pair" Opacity="0">
                        <Path x:Name="Large" Fill="{DynamicResource Accent}" Data="{StaticResource GearLarge}">
                            <Path.RenderTransform>
                                <RotateTransform CenterX="10" CenterY="10" />
                            </Path.RenderTransform>
                        </Path>
                        <Path x:Name="Small" Fill="{DynamicResource Accent}" Data="{StaticResource GearSmall}">
                            <Path.RenderTransform>
                                <RotateTransform CenterX="24.19" CenterY="14.43" />
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Appear">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pair"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Appear" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsVisible" Value="True" />
                                <Condition Property="local:MotionPreference.Enabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="Turn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Large"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="-360" Duration="0:0:3" RepeatBehavior="Forever" />
                                        <DoubleAnimation Storyboard.TargetName="Small"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:2" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Turn" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
