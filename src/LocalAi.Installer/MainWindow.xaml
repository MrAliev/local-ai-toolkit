<Window x:Class="LocalAi.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalAi.Installer.ViewModels"
        Background="{DynamicResource WindowFill}"
        Foreground="{DynamicResource TextPrimary}"
        Icon="pack://application:,,,/Resources/localai.ico"
        Title="{Binding WindowTitle}"
        Width="820"
        Height="620"
        MinWidth="780"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style x:Key="WarningText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource WarnText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <!-- The orientation pane: shows where the user is without any extra interaction. -->
        <DataTemplate x:Key="StepTemplate">
            <TextBlock Text="{Binding Title}" Margin="0,0,0,6" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 220, not 180: the merged page's rail entries are longer, and
                 Russian runs 15-30% longer than English. -->
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource RailFill}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
            <StackPanel Margin="16,20,12,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- The icon's own geometry, not a second drawing of it: the seal's
                         ring is a hole, which an even-odd figure expresses, so the rail and
                         assets/localai.ico cannot drift apart. MarkInk rather than AccentFill,
                         because the palette's accent is one colour in light and another in
                         dark, and a mark that changed with the theme would disagree with the
                         icon in the title bar above it. Themes/Brand.xaml says the rest. -->
                    <Path Grid.Column="0" Width="24" Height="24" Stretch="Uniform"
                          Fill="{StaticResource MarkInk}"
                          Data="F0 M0,0 H80 V144 H208 V224 H0 Z
                                M163,0 L208,26 V78 L163,104 L118,78 V26 Z
                                M163,14 L196,33 V71 L163,90 L130,71 V33 Z
                                M163,28 L184,40 V64 L163,76 L142,64 V40 Z" />
                    <!-- A picture cannot say "LocalAi", and this rail is the only place the
                         wizard names the product. The mark joins the wordmark; it does not
                         replace it. -->
                    <TextBlock Grid.Column="1" Text="LocalAi" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
                <!-- The one place a version is a question. Every other page states it. -->
                <TextBlock Text="{Binding VersionContext}" FontFamily="Consolas" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,16" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding StepList}"
                              ItemTemplate="{StaticResource StepTemplate}" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StepDescription}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding StepStatus}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                <Border Background="{DynamicResource ErrFill}" BorderBrush="{DynamicResource ErrLine}" BorderThickness="1" CornerRadius="3"
                        Padding="8,6" Margin="0,8,0,0"
                        Visibility="{Binding HasUnexpectedError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding UnexpectedError}" Foreground="{DynamicResource ErrText}" />
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- System check -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Diagnose}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Margin="0,4,0,0"
                                    Visibility="{Binding Diagnose.IsChecking, Converter={StaticResource BoolToVisibility}}">
                            <!-- The lead above already says what is happening; this is the
                                 detail line under the spinner. -->
                            <TextBlock Text="{x:Static vm:PageLabels.Probing}"
                                       Style="{StaticResource Muted}" Margin="0,0,0,10" />
                            <ProgressBar IsIndeterminate="True" Height="4" Width="280" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Diagnose.Checks}"
                                      Visibility="{Binding Diagnose.HasResults, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <!-- Auto with a floor rather than fixed: "Установлено"
                                                 and "Не найдено" do not fit the 80 that held
                                                 "Found", and a status clipped to "Установл" is
                                                 worse than a column that grows. -->
                                            <ColumnDefinition Width="Auto" MinWidth="150" />
                                            <ColumnDefinition Width="Auto" MinWidth="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   FontWeight="SemiBold" Margin="0,0,12,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                   Margin="0,0,12,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:CheckStatus.Warning}">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarnText}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:CheckStatus.Missing}">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarnText}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:CheckStatus.Blocking}">
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrText}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Diagnose.UnsupportedReason}"
                                   Style="{StaticResource WarningText}"
                                   Margin="0,10,0,0" />
                        <!-- A previous run that was killed mid-install left effects nobody
                             wrote down anywhere else; this is where they get offered back. -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding HasInterruptedRunNotice, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static vm:PageLabels.InterruptedRun}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding InterruptedRunNotice, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160"
                                     VerticalScrollBarVisibility="Auto" Background="{DynamicResource WarnFill}" />
                            <Button Content="{x:Static vm:PageLabels.RollBackPreviousRun}"
                                    Command="{Binding RollbackPreviousRunCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4"
                                    Visibility="{Binding HasInterruptedRun, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Prerequisites -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Dependencies}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ItemsControl ItemsSource="{Binding Dependencies.Dependencies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsConsented}"
                                                  IsEnabled="{Binding IsInstallable}"
                                                  Tag="{Binding Id}"
                                                  Checked="OnDependencyConsentChanged"
                                                  Unchecked="OnDependencyConsentChanged"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,8,0" />
                                        <!-- Two lines, not one long one. The name and the state are
                                             what somebody scans; what skipping costs is what they
                                             read when the scan stops, and joined onto the first
                                             line it ran off the page. -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding HeadLine, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding RequirementText, Mode=OneWay}"
                                                       Style="{StaticResource Muted}" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{x:Static vm:PageLabels.NoAutomatedInstaller}"
                                                       FontSize="11" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstallable}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- LocalAi package -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Package}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{x:Static vm:PageLabels.VersionToInstall}" />
                        <TextBox Text="{Binding Package.ReleaseVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="280" Height="24" HorizontalAlignment="Left" Margin="0,4,0,2" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="{x:Static vm:PageLabels.VersionHint}" />
                        <TextBlock Text="{x:Static vm:PageLabels.InstallFromFolder}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,4"
                                   Text="{x:Static vm:PageLabels.FolderHint}" />
                        <!-- Stretched rather than Width="480": a fixed width for a path is a clip
                             waiting for a deeper directory. The picker is here because typing the
                             path by hand was the only way to use this box. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Height="24"
                                     Text="{Binding Package.SourceFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="{x:Static vm:PageLabels.BrowseForFolder}"
                                    MinWidth="96" Padding="12,0" Height="24" Margin="8,0,0,0"
                                    Click="OnBrowseForReleaseFolder" />
                        </Grid>
                        <Button Content="{x:Static vm:PageLabels.CheckAgain}" MinWidth="140" Padding="12,0" Height="26" HorizontalAlignment="Left"
                                IsEnabled="{Binding Package.CanCheck}"
                                Click="OnPackageCheckRelease" />
                        <TextBlock Text="{Binding Package.StatusText}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                    </StackPanel>

                    <!-- Models and memory: the rule that decides what fits, above the list
                         that follows from it. These were two pages, and the recompute the rule
                         triggers landed on a page the reader had already left (#257). -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Models}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{x:Static vm:PageLabels.VideoMemory}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Residency.AdapterFound}"
                                   Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"
                                   Visibility="{Binding Residency.HasAdapterFound, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Residency.AdapterHint}"
                                   Style="{StaticResource WarningText}" Margin="0,0,0,8"
                                   Visibility="{Binding Residency.HasAdapterHint, Converter={StaticResource BoolToVisibility}}" />
                        <!-- The consequence sits inside the rule it belongs to. Bound to the rule
                             being chosen it was invisible until clicked, so three rules could not
                             be compared without clicking all three — and each click moved the
                             page under the pointer. Inside, it is also aligned by the control's
                             own template rather than by a margin measured against it. -->
                        <RadioButton GroupName="Residency" Margin="0,0,0,10"
                                     IsChecked="{Binding Residency.IsRequireFullVram, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="{x:Static vm:PageLabels.RequireFullVram}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Static vm:PageLabels.RequireFullVramHint}"
                                           Style="{StaticResource Muted}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Residency" Margin="0,0,0,10"
                                     IsChecked="{Binding Residency.IsAllowPartialOffload, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="{x:Static vm:PageLabels.AllowPartialOffload}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Static vm:PageLabels.AllowPartialOffloadHint}"
                                           Style="{StaticResource Muted}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Residency" Margin="0,0,0,10"
                                     IsChecked="{Binding Residency.IsAllowCpu, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="{x:Static vm:PageLabels.AllowCpu}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Static vm:PageLabels.AllowCpuHint}"
                                           Style="{StaticResource Muted}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <!-- The only thing on this page that appears, and the only one that
                             should: it says the chosen rule can degrade an answer. -->
                        <Border Background="{DynamicResource WarnFill}" BorderBrush="{DynamicResource WarnLine}"
                                BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,2,0,0"
                                Visibility="{Binding Residency.HasWarning, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Residency.Warning}"
                                       Style="{StaticResource WarningText}" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="{x:Static vm:PageLabels.LocalModels}" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <!-- The anchor: it restates the rule inside the group the rule governs,
                             so the dependency stays legible once the radios have scrolled away,
                             and its count moves the moment the rule does. -->
                        <TextBlock Text="{Binding Models.RuleSummary}"
                                   Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8" />
                        <RadioButton GroupName="ModelMode" Content="{x:Static vm:PageLabels.ChooseAutomatically}"
                                     IsChecked="{Binding Models.IsAutomatic, Mode=TwoWay}" Margin="0,0,0,4" />
                        <StackPanel Margin="23,0,0,10"
                                    Visibility="{Binding Models.IsAutomatic, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Models.AutomaticSummary}"
                                       Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Models.AutomaticSelection}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <RadioButton GroupName="ModelMode" Content="{x:Static vm:PageLabels.ChooseExactly}"
                                     IsChecked="{Binding Models.IsChooseExact, Mode=TwoWay}" Margin="0,0,0,4" />
                        <StackPanel Margin="23,0,0,10"
                                    Visibility="{Binding Models.IsChooseExact, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static vm:PageLabels.Model}" />
                            <!-- ItemTemplate, not DisplayMemberPath. The closed box draws
                                 SelectionBoxItemTemplate, which ComboBox computes from
                                 ItemTemplate and never from DisplayMemberPath: with the path
                                 alone the ContentPresenter fell back to ToString(), and
                                 ModelCatalogEntry is a positional record, so the box showed
                                 `ModelCatalogEntry { Tag = …, … }`. A tag is an identifier,
                                 hence Consolas, as the rail already sets for the version. -->
                            <ComboBox ItemsSource="{Binding Models.CatalogModels}"
                                      SelectedItem="{Binding Models.SelectedModel, Mode=TwoWay}"
                                      MinWidth="240" HorizontalAlignment="Left" Height="24"
                                      Margin="0,4,0,8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tag}" FontFamily="Consolas"
                                                   TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{x:Static vm:PageLabels.ContextSize}" />
                            <ComboBox ItemsSource="{Binding Models.AvailableContexts}"
                                      SelectedItem="{Binding Models.SelectedContext, Mode=TwoWay}"
                                      MaxWidth="160" HorizontalAlignment="Left" Height="24" Margin="0,4,0,6" />
                            <TextBlock Text="{x:Static vm:PageLabels.ContextSizeHint}"
                                       Style="{StaticResource Muted}" FontSize="11" />
                        </StackPanel>
                        <RadioButton GroupName="ModelMode" Content="{x:Static vm:PageLabels.SkipModelSetup}"
                                     IsChecked="{Binding Models.IsSkip, Mode=TwoWay}" Margin="0,0,0,4" />
                        <TextBlock Text="{x:Static vm:PageLabels.SkipModelSetupHint}"
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="23,0,0,0"
                                   Visibility="{Binding Models.IsSkip, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>


                    <!-- Client apps -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Agents}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ItemsControl ItemsSource="{Binding Agents.Agents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <!-- One heading, not four Runs: they concatenate in source
                                             order, which is the one thing a translation cannot keep. -->
                                        <TextBlock Text="{Binding Heading, Mode=OneWay}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <!-- The page where a person decides what happens to their
                                             clients showed `AgentChoiceOption { Choice = …, Title
                                             = … }`: DisplayMemberPath does not reach the closed
                                             box, which draws SelectionBoxItemTemplate, and that
                                             comes from ItemTemplate alone.

                                             Stretch rather than MinWidth="380": «Зарегистрировать
                                             MCP-серверы и установить инструкции» does not fit 380
                                             minus the chrome, and a width that fits English and
                                             not Russian is the defect this page is full of. -->
                                        <ComboBox Height="24" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                                  Tag="{Binding Agent}"
                                                  ItemsSource="{Binding DataContext.Agents.ChoiceOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Choice"
                                                  SelectedValue="{Binding Choice, Mode=OneWay}"
                                                  SelectionChanged="OnAgentChoiceChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Title}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <!-- Stated, not asked. Where a worktree goes is not a
                                             machine-wide question: the client has no setting for
                                             it, so the hook is the only way to move it, and which
                                             folder they land in is answered per repository by
                                             git config localai.worktreeRoot. Hidden on a row set
                                             to leave the client alone, where it would describe an
                                             effect that is not coming. -->
                                        <TextBlock Text="{Binding DataContext.Agents.WorktreePlacementHint, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="{Binding DataContext.Agents.ShowsWorktreePlacement, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <!-- The gate sits under the combo it depends on, and only
                                             in the Claude Code row: it is a PreToolUse hook in
                                             that client's own settings, and Codex has no such
                                             event. Its enabling condition is the combo directly
                                             above, which is why it is here rather than among the
                                             consents on the confirm page. -->
                                        <StackPanel Margin="0,8,0,0"
                                                    Visibility="{Binding HasTextSearchGate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <CheckBox Content="{x:Static vm:PageLabels.RefuseTextSearch}"
                                                      IsChecked="{Binding DataContext.Agents.RefusesTextSearch, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                      IsEnabled="{Binding DataContext.Agents.CanRefuseTextSearch, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                                            <TextBlock Text="{Binding DataContext.Agents.TextSearchHint, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                                       Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="24,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Confirm: a milestone page, summary and consent only. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Confirm}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBox Text="{Binding ReviewText, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" Height="200"
                                 VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}" />
                        <!-- Two questions, two buttons, in review-box row order: the release
                             is the first row, the settings are the rest. -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{x:Static vm:PageLabels.ChooseARelease}"
                                    Command="{Binding RevealReleaseCommand}"
                                    Padding="12,4" Margin="0,0,8,0"
                                    Visibility="{Binding IsReleaseFolded, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{x:Static vm:PageLabels.ChangeSettings}"
                                    Command="{Binding RevealSettingsCommand}"
                                    Padding="12,4"
                                    Visibility="{Binding AreSettingsFolded, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <CheckBox Content="{Binding ConsentText}"
                                  Margin="0,12,0,0"
                                  IsChecked="{Binding Review.IsConfirmed, Mode=TwoWay}"
                                  Checked="OnReviewConfirmedChanged"
                                  Unchecked="OnReviewConfirmedChanged" />
                        <!-- Opt-in, off unless ticked, with what it does stated beside it
                             rather than in a document nobody opens. -->
                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="3"
                                Padding="10,8" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{x:Static vm:PageLabels.AfterThisInstallation}" FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <CheckBox Content="{x:Static vm:PageLabels.EnableUpdateCheck}"
                                          IsChecked="{Binding Review.EnableUpdateCheck, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{x:Static vm:PageLabels.UpdateCheckHint}" />
                                <TextBlock Text="{Binding Review.UpdateCheckDisclosure, Mode=OneTime}"
                                           Style="{StaticResource Muted}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Progress -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Progress}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="16" />
                        <TextBlock Text="{x:Static vm:PageLabels.Log}" Margin="0,14,0,4" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Finish.Progress, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" Height="200"
                                 VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}" />
                    </StackPanel>

                    <!-- Finish -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Finish}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBox Text="{Binding FinishSummary, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" Height="110"
                                 VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}" />
                        <TextBlock Text="{x:Static vm:PageLabels.Log}" Margin="0,12,0,4" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Finish.Progress, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" Height="180"
                                 VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}" />
                        <!-- Only after a failed or cancelled run with reversible effects:
                             rollback is a recovery, not an uninstaller for a good run. -->
                        <Button Content="{x:Static vm:PageLabels.RollBackChanges}"
                                Command="{Binding RollbackCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,4"
                                Visibility="{Binding CanRollback, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{Binding Finish.HasRollbackReport, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static vm:PageLabels.Rollback}" Margin="0,12,0,4" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Finish.RollbackReport, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap" Height="140"
                                     VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Navigation stays in place for the whole wizard; only availability changes. -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static vm:PageLabels.Back}" Style="{StaticResource NavButton}"
                            Command="{Binding BackCommand}" />
                    <Button Content="{x:Static vm:PageLabels.Next}" Style="{StaticResource NavButton}"
                            Command="{Binding NextCommand}"
                            Visibility="{Binding IsNextVisible, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{Binding ActionText}" Style="{StaticResource NavButton}" IsDefault="True"
                            Command="{Binding InstallCommand}"
                            Visibility="{Binding IsInstallVisible, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{Binding CancelButtonText}" Style="{StaticResource NavButton}" IsCancel="True"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
