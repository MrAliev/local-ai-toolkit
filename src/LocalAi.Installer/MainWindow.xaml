<Window x:Class="LocalAi.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalAi.Installer.ViewModels"
        xmlns:local="clr-namespace:LocalAi.Installer"
        Background="{DynamicResource WindowFill}"
        Foreground="{DynamicResource TextPrimary}"
        Icon="pack://application:,,,/Resources/localai.ico"
        Title="{Binding WindowTitle}"
        Width="820"
        Height="620"
        MinWidth="780"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <Window.Resources>
        <local:CompactRailWidthConverter x:Key="RailWidth" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style x:Key="WarningText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource WarnText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- The mark beside a row, for every list in this window that has states. Declared once:
             two copies would be two vocabularies the day one of them gained a state.

             The turning arc needs a RotateTransform the row owns, so that stays on the element —
             a Freezable in a Setter is shared by every row that uses the style. WPF hands a
             template's transform over frozen and the animation system replaces it with a mutable
             copy; that is measured rather than assumed. -->
        <Style x:Key="RowMark" TargetType="Path">
            <Setter Property="local:MotionPreference.Enabled" Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Data" Value="{StaticResource MarkNone}" />
            <Setter Property="Stroke" Value="{DynamicResource TextDisabled}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mark}" Value="{x:Static vm:RunMark.None}">
                    <Setter Property="Data" Value="{StaticResource MarkNone}" />
                    <Setter Property="Stroke" Value="{DynamicResource TextDisabled}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Mark}" Value="{x:Static vm:RunMark.Busy}">
                    <Setter Property="Data" Value="{StaticResource MarkBusy}" />
                    <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Mark}" Value="{x:Static vm:RunMark.Busy}" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(local:MotionPreference.Enabled)}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Spin">
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                    From="0" To="360" Duration="0:0:1.1"
                                    RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Spin" />
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Mark}" Value="{x:Static vm:RunMark.Done}">
                    <Setter Property="Data" Value="{StaticResource MarkTick}" />
                    <Setter Property="Stroke" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Mark}" Value="{x:Static vm:RunMark.Warned}">
                    <Setter Property="Data" Value="{StaticResource MarkWarn}" />
                    <Setter Property="Stroke" Value="{DynamicResource WarnText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Mark}" Value="{x:Static vm:RunMark.Failed}">
                    <Setter Property="Data" Value="{StaticResource MarkFail}" />
                    <Setter Property="Stroke" Value="{DynamicResource ErrText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <!-- The orientation pane: shows where the user is without any extra interaction. -->
        <DataTemplate x:Key="StepTemplate">
            <TextBlock Text="{Binding Title}" Margin="0,0,0,6" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="ShellLayout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ActualWidth, ElementName=ShellLayout, Converter={StaticResource RailWidth}, ConverterParameter=220}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource RailFill}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,20,12,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- The icon's own geometry, not a second drawing of it: the seal's
                         ring is a hole, which an even-odd figure expresses, so the rail and
                         assets/localai.ico cannot drift apart. MarkInk rather than AccentFill,
                         because the palette's accent is one colour in light and another in
                         dark, and a mark that changed with the theme would disagree with the
                         icon in the title bar above it. Themes/Brand.xaml says the rest. -->
                    <Path Grid.Column="0" Width="24" Height="24" Stretch="Uniform"
                          Fill="{StaticResource MarkInk}"
                          Data="F0 M0,0 H80 V144 H208 V224 H0 Z
                                M163,0 L208,26 V78 L163,104 L118,78 V26 Z
                                M163,14 L196,33 V71 L163,90 L130,71 V33 Z
                                M163,28 L184,40 V64 L163,76 L142,64 V40 Z" />
                    <!-- A picture cannot say "LocalAi", and this rail is the only place the
                         wizard names the product. The mark joins the wordmark; it does not
                         replace it. -->
                    <TextBlock Grid.Column="1" Text="LocalAi" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
                <!-- The one place a version is a question. Every other page states it. -->
                <TextBlock Text="{Binding VersionContext}" FontFamily="Consolas" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,16" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding StepList}"
                              ItemTemplate="{StaticResource StepTemplate}" />
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Top margin 20, as on the rail, so the panel lines up with the product name. -->
        <Grid Grid.Column="1" Margin="20,20,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- In the content column rather than across the window, so the rail keeps the
                 product name at its top; outside the scroll area, so it is on every page. -->
            <local:PreferencesBar Grid.Row="0" Margin="0,0,0,12"
                                  DataContext="{Binding Presentation}" />

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <local:LiveStatusText Text="{Binding StepTitle}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StepDescription}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding StepStatus}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                <Border Background="{DynamicResource ErrFill}" BorderBrush="{DynamicResource ErrLine}" BorderThickness="1" CornerRadius="3"
                        Padding="8,6" Margin="0,8,0,0"
                        Visibility="{Binding HasUnexpectedError, Converter={StaticResource BoolToVisibility}}">
                    <local:LiveStatusText Text="{Binding UnexpectedError}" TextWrapping="Wrap"
                                          AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource ErrText}" />
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- System check -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Diagnose}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Margin="0,4,0,0"
                                    Visibility="{Binding Diagnose.IsChecking, Converter={StaticResource BoolToVisibility}}">
                            <!-- The lead above already says what is happening; this is the
                                 detail line under the spinner. -->
                            <TextBlock Text="{vm:Label Probing}"
                                       Style="{StaticResource Muted}" Margin="0,0,0,10" />
                            <ProgressBar IsIndeterminate="True" Height="4" Width="280" HorizontalAlignment="Left" />
                        </StackPanel>
                        <!-- A shared size scope, because this reads as a table and was not one:
                             each row had its own Grid, so Auto sized every row on its own and
                             «Свободное место на диске» pushed its OK right of the eight above. -->
                        <ItemsControl ItemsSource="{Binding Diagnose.Checks}"
                                      Grid.IsSharedSizeScope="True"
                                      Visibility="{Binding Diagnose.HasResults, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <!-- The floors no longer align anything — the scope
                                                 does that — so they are only what a run of short
                                                 labels falls back to, and can be smaller than the
                                                 longest label in either language. -->
                                            <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="CheckName" />
                                            <ColumnDefinition Width="Auto" MinWidth="60" SharedSizeGroup="CheckStatus" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   FontWeight="SemiBold" Margin="0,0,12,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                   Margin="0,0,12,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:CheckStatus.Warning}">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarnText}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:CheckStatus.Missing}">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarnText}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:CheckStatus.Blocking}">
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrText}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <local:LiveStatusText Text="{Binding Diagnose.Announcement}"
                                   Style="{StaticResource Muted}"
                                   Margin="0,10,0,0" />
                        <!-- A previous run that was killed mid-install left effects nobody
                             wrote down anywhere else; this is where they get offered back. -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding HasInterruptedRunNotice, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{vm:Label InterruptedRun}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding InterruptedRunNotice, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160"
                                     VerticalScrollBarVisibility="Auto" Background="{DynamicResource WarnFill}" />
                            <Button Content="{vm:Label RollBackPreviousRun}"
                                    Command="{Binding RollbackPreviousRunCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4"
                                    Visibility="{Binding HasInterruptedRun, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Prerequisites -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Dependencies}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ItemsControl ItemsSource="{Binding Dependencies.Dependencies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsConsented}"
                                                  IsEnabled="{Binding IsInstallable}"
                                                  Tag="{Binding Id}"
                                                  Checked="OnDependencyConsentChanged"
                                                  Unchecked="OnDependencyConsentChanged"
                                                  AutomationProperties.Name="{Binding AccessibleName}"
                                                  AutomationProperties.HelpText="{Binding RequirementText}"
                                                  Margin="0,0,0,10">
                                        <!-- Two lines, not one long one. The name and the state are
                                             what somebody scans; what skipping costs is what they
                                             read when the scan stops, and joined onto the first
                                             line it ran off the page. -->
                                        <StackPanel>
                                            <TextBlock Text="{Binding HeadLine, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding RequirementText, Mode=OneWay}"
                                                       Style="{StaticResource Muted}" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{vm:Label NoAutomatedInstaller}"
                                                       FontSize="11" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstallable}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- LocalAi package -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Package}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock x:Name="VersionLabel" Text="{vm:Label VersionToInstall}" />
                        <TextBox AutomationProperties.Name="{Binding Text, ElementName=VersionLabel}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=VersionLabel}"
                                 AutomationProperties.HelpText="{vm:Label VersionHint}"
                                 Text="{Binding Package.ReleaseVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="240" MinHeight="32" HorizontalAlignment="Stretch" Margin="0,4,0,2" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="{vm:Label VersionHint}" />
                        <TextBlock x:Name="ReleaseFolderLabel" Text="{vm:Label ReleaseFolder}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,4"
                                   Text="{vm:Label FolderHint}" />
                        <!-- Stretched rather than Width="480": a fixed width for a path is a clip
                             waiting for a deeper directory. The picker is here because typing the
                             path by hand was the only way to use this box. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" MinHeight="32" AutomationProperties.Name="{Binding Text, ElementName=ReleaseFolderLabel}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=ReleaseFolderLabel}"
                                     AutomationProperties.HelpText="{vm:Label FolderHint}"
                                     Text="{Binding Package.SourceFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="{vm:Label BrowseForFolder}"
                                    MinWidth="96" Padding="12,0" MinHeight="32" Margin="8,0,0,0"
                                    Click="OnBrowseForReleaseFolder" />
                        </Grid>
                        <Button Content="{vm:Label CheckAgain}" MinWidth="140" Padding="12,0" MinHeight="32" HorizontalAlignment="Left"
                                IsEnabled="{Binding Package.CanCheck}"
                                Click="OnPackageCheckRelease" />
                        <TextBlock Text="{Binding Package.StatusText}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                    </StackPanel>

                    <!-- Models and memory: the rule for how models may run, above the list of
                         models setup installs. These were two pages (#257). -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Models}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock x:Name="VideoMemoryLabel" Text="{vm:Label VideoMemory}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Residency.AdapterFound}"
                                   Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"
                                   Visibility="{Binding Residency.HasAdapterFound, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Residency.AdapterHint}"
                                   Style="{StaticResource WarningText}" Margin="0,0,0,8"
                                   Visibility="{Binding Residency.HasAdapterHint, Converter={StaticResource BoolToVisibility}}" />
                        <!-- The consequence sits inside the rule it belongs to. Bound to the rule
                             being chosen it was invisible until clicked, so three rules could not
                             be compared without clicking all three — and each click moved the
                             page under the pointer. Inside, it is also aligned by the control's
                             own template rather than by a margin measured against it. -->
                        <GroupBox Style="{StaticResource NamedGroup}"
                                  AutomationProperties.LabeledBy="{x:Reference VideoMemoryLabel}">
                            <StackPanel>
                                <RadioButton GroupName="Residency" Margin="0,0,0,10"
                                             IsChecked="{Binding Residency.IsRequireFullVram, Mode=TwoWay}"
                                             AutomationProperties.Name="{vm:Label RequireFullVram}"
                                             AutomationProperties.HelpText="{vm:Label RequireFullVramHint}">
                                    <StackPanel>
                                        <TextBlock Text="{vm:Label RequireFullVram}" TextWrapping="Wrap" />
                                        <TextBlock Text="{vm:Label RequireFullVramHint}"
                                                   Style="{StaticResource Muted}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Residency" Margin="0,0,0,10"
                                             IsChecked="{Binding Residency.IsAllowPartialOffload, Mode=TwoWay}"
                                             AutomationProperties.Name="{vm:Label AllowPartialOffload}"
                                             AutomationProperties.HelpText="{vm:Label AllowPartialOffloadHint}">
                                    <StackPanel>
                                        <TextBlock Text="{vm:Label AllowPartialOffload}" TextWrapping="Wrap" />
                                        <TextBlock Text="{vm:Label AllowPartialOffloadHint}"
                                                   Style="{StaticResource Muted}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Residency" Margin="0,0,0,10"
                                             IsChecked="{Binding Residency.IsAllowCpu, Mode=TwoWay}"
                                             AutomationProperties.Name="{vm:Label AllowCpu}"
                                             AutomationProperties.HelpText="{vm:Label AllowCpuHint}">
                                    <StackPanel>
                                        <TextBlock Text="{vm:Label AllowCpu}" TextWrapping="Wrap" />
                                        <TextBlock Text="{vm:Label AllowCpuHint}"
                                                   Style="{StaticResource Muted}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </GroupBox>
                        <!-- The only thing on this page that appears, and the only one that
                             should: it says the chosen rule can degrade an answer. -->
                        <Border Background="{DynamicResource WarnFill}" BorderBrush="{DynamicResource WarnLine}"
                                BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,2,0,0"
                                Visibility="{Binding Residency.HasWarning, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Residency.Warning}"
                                       Style="{StaticResource WarningText}" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock x:Name="LocalModelsLabel" Text="{vm:Label LocalModels}" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <!-- The anchor: it restates the rule inside the group the rule governs,
                             so the dependency stays legible once the radios have scrolled away,
                             and its count moves the moment the rule does. -->
                        <TextBlock Text="{Binding Models.RuleSummary}"
                                   Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8" />
                        <GroupBox Style="{StaticResource NamedGroup}"
                                  AutomationProperties.LabeledBy="{x:Reference LocalModelsLabel}">
                            <StackPanel>
                                <RadioButton GroupName="ModelMode" Content="{vm:Label ChooseAutomatically}"
                                             AutomationProperties.HelpText="{Binding Models.AutomaticSummary}"
                                             IsChecked="{Binding Models.IsAutomatic, Mode=TwoWay}" Margin="0,0,0,4" />
                                <StackPanel Margin="23,0,0,10"
                                            Visibility="{Binding Models.IsAutomatic, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Models.AutomaticSummary}"
                                               Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Models.AutomaticSelection}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <RadioButton GroupName="ModelMode" Content="{vm:Label ChooseExactly}"
                                             IsChecked="{Binding Models.IsChooseExact, Mode=TwoWay}" Margin="0,0,0,4" />
                                <StackPanel Margin="23,0,0,10"
                                            Visibility="{Binding Models.IsChooseExact, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock x:Name="ModelLabel" Text="{vm:Label ModelToInstall}" />
                                    <!-- ItemTemplate, not DisplayMemberPath. The closed box draws
                                         SelectionBoxItemTemplate, which ComboBox computes from
                                         ItemTemplate and never from DisplayMemberPath: with the path
                                         alone the ContentPresenter fell back to ToString(), and
                                         ModelCatalogEntry is a positional record, so the box showed
                                         `ModelCatalogEntry { Tag = …, … }`. A tag is an identifier,
                                         hence Consolas, as the rail already sets for the version. -->
                                    <ComboBox AutomationProperties.Name="{Binding Text, ElementName=ModelLabel}"
                                              AutomationProperties.LabeledBy="{Binding ElementName=ModelLabel}"
                                              ItemsSource="{Binding Models.CatalogModels}"
                                              SelectedItem="{Binding Models.SelectedModel, Mode=TwoWay}"
                                              MinWidth="240" HorizontalAlignment="Left" MinHeight="32"
                                              Margin="0,4,0,8">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Tag}" FontFamily="Consolas"
                                                           TextWrapping="NoWrap" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock x:Name="ModelContextLabel" Text="{vm:Label ModelContextSize}" />
                                    <ComboBox AutomationProperties.Name="{Binding Text, ElementName=ModelContextLabel}"
                                              AutomationProperties.LabeledBy="{Binding ElementName=ModelContextLabel}"
                                              AutomationProperties.HelpText="{vm:Label ContextSizeHint}"
                                              ItemsSource="{Binding Models.AvailableContexts}"
                                              SelectedItem="{Binding Models.SelectedContext, Mode=TwoWay}"
                                              HorizontalAlignment="Left" MinHeight="32" Margin="0,4,0,6" />
                                    <TextBlock Text="{vm:Label ContextSizeHint}"
                                               Style="{StaticResource Muted}" FontSize="11" />
                                </StackPanel>
                                <RadioButton GroupName="ModelMode" Content="{vm:Label SkipModelSetup}"
                                             AutomationProperties.HelpText="{vm:Label SkipModelSetupHint}"
                                             IsChecked="{Binding Models.IsSkip, Mode=TwoWay}" Margin="0,0,0,4" />
                                <TextBlock Text="{vm:Label SkipModelSetupHint}"
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="23,0,0,0"
                                           Visibility="{Binding Models.IsSkip, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>


                    <!-- Client apps -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Agents}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ItemsControl ItemsSource="{Binding Agents.Agents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <!-- One heading, not four Runs: they concatenate in source
                                             order, which is the one thing a translation cannot keep. -->
                                        <TextBlock Text="{Binding Heading, Mode=OneWay}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <!-- The page where a person decides what happens to their
                                             clients showed `AgentChoiceOption { Choice = …, Title
                                             = … }`: DisplayMemberPath does not reach the closed
                                             box, which draws SelectionBoxItemTemplate, and that
                                             comes from ItemTemplate alone.

                                             Stretch rather than MinWidth="380": «Зарегистрировать
                                             MCP-серверы и установить инструкции» does not fit 380
                                             minus the chrome, and a width that fits English and
                                             not Russian is the defect this page is full of. -->
                                        <TextBlock x:Name="ClientChoiceLabel" Text="{Binding AccessibleName}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <ComboBox AutomationProperties.Name="{Binding Text, ElementName=ClientChoiceLabel}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=ClientChoiceLabel}"
                                                  MinHeight="32" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                                  Tag="{Binding Agent}"
                                                  ItemsSource="{Binding DataContext.Agents.ChoiceOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Choice"
                                                  SelectedValue="{Binding Choice, Mode=OneWay}"
                                                  SelectionChanged="OnAgentChoiceChanged">
                                            <!-- Help only while the sentence below is shown:
                                                 hidden, it describes an effect that is not coming. -->
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=WorktreeHint}" Value="Visible">
                                                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Text, ElementName=WorktreeHint}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Title}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <!-- Stated, not asked. Where a worktree goes is not a
                                             machine-wide question: the client has no setting for
                                             it, so the hook is the only way to move it, and which
                                             folder they land in is answered per repository by
                                             git config localai.worktreeRoot. Shown only under a
                                             Claude Code row that configures the client: anywhere
                                             else it would describe an effect that is not coming. -->
                                        <TextBlock x:Name="WorktreeHint"
                                                   Text="{Binding DataContext.Agents.WorktreePlacementHint, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="{Binding ShowsWorktreePlacement, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <!-- The gate sits under the combo it depends on, and only
                                             in the Claude Code row: it is a PreToolUse hook in
                                             that client's own settings, and Codex has no such
                                             event. Its enabling condition is the combo directly
                                             above, which is why it is here rather than among the
                                             consents on the confirm page. -->
                                        <StackPanel Margin="0,8,0,0"
                                                    Visibility="{Binding HasTextSearchGate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <CheckBox AutomationProperties.Name="{vm:Label RefuseTextSearch}"
                                                      AutomationProperties.HelpText="{Binding DataContext.Agents.TextSearchHint, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                                      IsChecked="{Binding DataContext.Agents.RefusesTextSearch, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                      IsEnabled="{Binding DataContext.Agents.CanRefuseTextSearch, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}">
                                                <TextBlock Text="{vm:Label RefuseTextSearch}" TextWrapping="Wrap" />
                                            </CheckBox>
                                            <TextBlock Text="{Binding DataContext.Agents.TextSearchHint, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                                       Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="24,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Confirm: a milestone page, summary and consent only. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Confirm}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <local:EffectsOverview DataContext="{Binding ReviewGroups}" />
                        <Expander Header="{vm:Label TechnicalDetails}">
                            <TextBox Text="{Binding ReviewText, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap" Height="200"
                                     VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}" />
                        </Expander>
                        <!-- Two questions, two buttons, in review-box row order: the release
                             is the first row, the settings are the rest. -->
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="{vm:Label ChooseARelease}"
                                    Command="{Binding RevealReleaseCommand}"
                                    Padding="12,4" Margin="0,0,8,0"
                                    Visibility="{Binding IsReleaseFolded, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{vm:Label ChangeSettings}"
                                    Command="{Binding RevealSettingsCommand}"
                                    Padding="12,4"
                                    Visibility="{Binding AreSettingsFolded, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <!-- Opt-in, off unless ticked, with what it does stated beside it
                             rather than in a document nobody opens. -->
                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="3"
                                Padding="10,8" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{vm:Label AfterThisInstallation}" FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <CheckBox AutomationProperties.Name="{vm:Label EnableUpdateCheck}"
                                          IsChecked="{Binding Review.EnableUpdateCheck, Mode=TwoWay}">
                                    <!-- Both sentences shown below, in their order. -->
                                    <AutomationProperties.HelpText>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Source="{x:Static vm:LiveLabels.Current}" Path="[UpdateCheckHint]" Mode="OneWay" />
                                            <Binding Path="Review.UpdateCheckDisclosure" Mode="OneWay" />
                                        </MultiBinding>
                                    </AutomationProperties.HelpText>
                                    <TextBlock Text="{vm:Label EnableUpdateCheck}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{vm:Label UpdateCheckHint}" />
                                <TextBlock Text="{Binding Review.UpdateCheckDisclosure, Mode=OneWay}"
                                           Style="{StaticResource Muted}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <CheckBox AutomationProperties.Name="{Binding ConsentText}"
                                  Margin="0,12,0,0"
                                  IsChecked="{Binding Review.IsConfirmed, Mode=TwoWay}"
                                  Checked="OnReviewConfirmedChanged"
                                  Unchecked="OnReviewConfirmedChanged">
                            <TextBlock Text="{Binding ConsentText}" TextWrapping="Wrap" />
                        </CheckBox>
                    </StackPanel>

                    <!-- Progress -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Progress}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="8" />

                        <!-- A row per model, because six of them take tens of minutes and one
                             sentence for all of it never said which one the run was on. Hidden
                             entirely when there are none: a heading over no rows is a question
                             about an absence. -->
                        <TextBlock Text="{vm:Label LocalModels}" FontWeight="SemiBold"
                                   Margin="0,16,0,6"
                                   Visibility="{Binding HasModelRuns, Converter={StaticResource BoolToVisibility}}" />
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasModelRuns, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding ModelRuns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Style="{StaticResource RowMark}"
                                                  Margin="0,3,10,0"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform />
                                                </Path.RenderTransform>
                                            </Path>
                                            <local:LiveStatusText Grid.Column="1" FontSize="12" TextWrapping="Wrap" Announcement="{Binding Announcement}">
                                                <Run Text="{Binding Tag, Mode=OneWay}" FontFamily="Consolas" /><Run Text=" — " /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}" />
                                            </local:LiveStatusText>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="{vm:Label Log}" Margin="0,14,0,4" FontWeight="SemiBold" />
                        <local:LogView LogText="{Binding Finish.Progress, Mode=OneWay}" Height="160" />
                    </StackPanel>

                    <!-- Finish -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:InstallerPage.Finish}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- A row per thing the run touched. This was four counters in a scroll
                             box, and on the ordinary run — where the machine already has every
                             prerequisite — they read "0. 0. 0. 0." beside a package that had
                             either installed or not, and said nothing about which. -->
                        <ItemsControl ItemsSource="{Binding Finish.Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Style="{StaticResource RowMark}"
                                              Margin="0,3,10,0" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform />
                                            </Path.RenderTransform>
                                        </Path>
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The one question somebody has here, and it was a log line under
                             eighty others in a box that did not scroll to it. -->
                        <TextBlock Text="{vm:Label WhatToDoNext}" FontWeight="SemiBold"
                                   Margin="0,14,0,4"
                                   Visibility="{Binding Finish.HasNextSteps, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Finish.NextSteps}" TextWrapping="Wrap"
                                   Visibility="{Binding Finish.HasNextSteps, Converter={StaticResource BoolToVisibility}}" />

                        <Grid Margin="0,14,0,0"
                              Visibility="{Binding Finish.HasReportPath, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- A read-only box rather than a label: the path is the thing somebody
                                 copies when they are asked for the log. -->
                            <TextBox Grid.Column="0" Text="{Binding Finish.ReportPath, Mode=OneWay}"
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="{vm:Label OpenReportFolder}"
                                    Padding="12,4" Margin="8,0,0,0" Click="OnOpenReportFolder" />
                        </Grid>

                        <!-- A run where something did not complete opens its log; a run that went
                             right folds it. -->
                        <Expander Header="{vm:Label Log}" Margin="0,14,0,0"
                                  IsExpanded="{Binding OpensTheLog, Mode=OneWay}">
                            <local:LogView LogText="{Binding Finish.Progress, Mode=OneWay}" Height="220" Margin="0,6,0,0" />
                        </Expander>
                        <!-- Only after a failed or cancelled run with reversible effects:
                             rollback is a recovery, not an uninstaller for a good run. -->
                        <Button Content="{vm:Label RollBackChanges}"
                                Command="{Binding RollbackCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,4"
                                Visibility="{Binding CanRollback, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{Binding Finish.HasRollbackReport, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{vm:Label Rollback}" Margin="0,12,0,4" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Finish.RollbackReport, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap" Height="140"
                                     VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Navigation stays in place for the whole wizard; only availability changes. -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="{vm:Label Back}" Style="{StaticResource NavButton}"
                            Command="{Binding BackCommand}" />
                    <Button Content="{vm:Label Next}" Style="{StaticResource NavButton}"
                            IsDefault="{Binding IsNextVisible}"
                            Command="{Binding NextCommand}"
                            Visibility="{Binding IsNextVisible, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{Binding ActionText}" Style="{StaticResource NavButton}" IsDefault="{Binding IsInstallVisible}"
                            Command="{Binding InstallCommand}"
                            Visibility="{Binding IsInstallVisible, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{Binding CancelButtonText}" Style="{StaticResource NavButton}" IsCancel="True"
                            Command="{Binding CancelCommand}" />
                </WrapPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
