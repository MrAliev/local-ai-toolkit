<UserControl x:Class="LocalAi.Installer.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LocalAi.Installer.ViewModels"
             x:Name="Root" Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="Entries" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                 AutomationProperties.Name="{vm:Label Log}"
                 VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface}"
                 ScrollViewer.ScrollChanged="OnScrollChanged" />
        <Button x:Name="JumpButton" Grid.Row="1" Margin="0,4,0,0" MinHeight="32"
                Padding="8,4" Visibility="Collapsed" Click="OnJumpToLatest">
            <TextBlock TextWrapping="Wrap">
                <Run Text="{vm:Label JumpToLatestEntries}" /><Run Text=" — " /><Run Text="{vm:Label NewLogLines}" /><Run Text=" "/><Run Text="{Binding UnreadLines, ElementName=Root, Mode=OneWay}" />
            </TextBlock>
        </Button>
    </Grid>
</UserControl>
